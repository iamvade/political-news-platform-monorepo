# API origin used by server components (not exposed to the browser)
API_URL=http://localhost:4000
# Set to true to serve /styleguide in a production build (it is always available in `next dev`).
STYLEGUIDE_ENABLED=
# Public origin of this site (canonical URLs, Open Graph, JSON-LD). Required for production builds.
SITE_URL=http://localhost:3000
# Shared with the API's WEB_REVALIDATE_SECRET (at least 32 chars). Without it /api/revalidate answers 503.
# WEB_REVALIDATE_SECRET=replace-me-with-a-random-secret-of-at-least-32-chars
