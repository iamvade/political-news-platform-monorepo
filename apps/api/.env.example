NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Matches docker-compose.yml (local dev only)
DATABASE_URL=postgres://news:news@localhost:5433/news
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of allowed browser origins (admin + web)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Set to true only when running behind a trusted proxy/CDN (Cloudflare)
TRUST_PROXY=false

# HMAC key for CSRF tokens (min 32 chars). Generate: openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-random-secret-of-at-least-32-chars

# Session cookie Secure flag. Keep true; set false only for Safari on http://localhost.
SESSION_COOKIE_SECURE=true

RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# Optional overrides for the test suite (must point at a *_test database)
# TEST_DATABASE_URL=postgres://news:news@localhost:5433/news_test
# TEST_REDIS_URL=redis://localhost:6379/15

# Run BullMQ workers (scheduled publish, revalidation, push, search) in the API process.
WORKERS_ENABLED=true

# Next.js on-demand revalidation (optional; jobs are skipped when unset)
# WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
# WEB_REVALIDATE_SECRET=replace-me-with-a-random-secret-of-at-least-32-chars

# --- Media storage (S3-compatible: Cloudflare R2 in production, SeaweedFS from docker-compose locally) ---
# Set all of these or none. Production: S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY_ID=dev-access-key
S3_SECRET_ACCESS_KEY=dev-secret-key-not-for-production
S3_REGION=auto
# Private: originals keep EXIF incl. GPS. Never expose this bucket publicly.
MEDIA_ORIGINALS_BUCKET=news-media-originals
# Public: generated WebP variants only.
MEDIA_PUBLIC_BUCKET=news-media-public
# Public base URL of the public bucket (R2 custom domain in production)
MEDIA_PUBLIC_BASE_URL=http://localhost:8333/news-media-public
MEDIA_MAX_BYTES=15728640
