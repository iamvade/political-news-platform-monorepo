{
  "name": "@news/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "admin:create": "tsx --env-file-if-exists=.env src/cli/create-admin.ts",
    "storage:init": "tsx --env-file-if-exists=.env src/cli/storage-init.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@news/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "aws4fetch": "^1.0.20",
    "bullmq": "^6.3.11",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.6.0",
    "postgres": "^3.4.9",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
